{
  "name": "gubots",
  "version": "1.0.0",
  "description": "Equipe local de agentes de IA (Claude Code + Codex)",
  "scripts": {
    "start": "node --no-warnings server/index.ts",
    "dev": "node --no-warnings --watch-path=server server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --no-warnings --test test/smoke.test.ts",
    "check": "tsc --noEmit -p web && tsc --noEmit --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target esnext --skipLibCheck --types node server/index.ts test/smoke.test.ts",
    "design:setup": "node scripts/setup-design.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.305",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex": "^0.163.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "lucide-react": "^1.60.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
