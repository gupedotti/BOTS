# Opcional: apps via Composio (OAuth gerido pelo Composio)
COMPOSIO_API_KEY=
# Opcional: ditado por voz pela API (o padrão é Whisper local, sem chave). Escolha o motor em Configurações.
ELEVENLABS_API_KEY=
# Opcional: porta / interface (padrão 127.0.0.1:8787). Acesso de fora do PC (túnel/Tailscale) exige login por senha.
# PORT=8787
# URL pública mostrada em Configurações → Celular e acesso
GUBOTS_PUBLIC_URL=
# HOST=127.0.0.1
# GUBOTS_HEADED=1   # Chrome com janela visível
# GUBOTS_ADBLOCK=0 # desliga o bloqueio de anúncios/rastreadores no navegador dos bots
